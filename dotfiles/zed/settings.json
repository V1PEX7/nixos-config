// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "format_on_save": "on",
  "vim_mode": false,
  "tabs": {
    "close_position": "left"
  },
  "edit_predictions": {
    "provider": "none"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "auto_update_extensions": {
    "nix": false
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "openrouter",
      "model": "openrouter/auto",
    },
    "model_parameters": [],
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": true,
    "indent_size": 14.0,
    "folder_icons": true,
    "dock": "left",
  },
  "icon_theme": "Zed (Default)",
  "buffer_font_family": ".ZedMono",
  "ui_font_family": ".ZedSans",
  "agent_ui_font_size": 21.0,
  "disable_ai": true,
  "ui_font_size": 20.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Darker Horizon",
  },
}
